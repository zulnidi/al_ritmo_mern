# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=5000
# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/al_ritmo
# Orígenes permitidos por CORS, separados por coma. Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:5173
# Límite de peticiones por IP en una ventana de 15 minutos
RATE_LIMIT_MAX=300
